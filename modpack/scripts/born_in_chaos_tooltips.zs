events.register<crafttweaker.forge.api.event.item.ItemTooltipEvent>(event => {
    if event.itemStack.registryName.namespace != "born_in_chaos_v1" {
        return;
    }
    var tip = event.tooltip;
    var i = 0;
    for line in tip {
        var raw = line.getString();
        for english, portuguese in fix {
            if raw == english {
                tip[i] = Component.literal(portuguese);
            }
        }
        i = i + 1;
    }
});
#endif
